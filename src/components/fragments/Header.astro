---
import Navigation from "../static/Navigation.astro";
import Utility from "../static/Utility.astro";
const pathname = Astro.url.pathname;
---

<header class="header-margin bg-background sticky top-0 z-200 border border-border">
	<div class="flex items-center justify-between">
		<nav>
			<Navigation pathname={pathname} client:load />
		</nav>
		<Utility />
	</div>
</header>
