---
import Header from "@/components/static/Header.astro";
import "@/styles/global.css";
import "@/styles/typography.css";
import Head from "@/components/static/Head.astro";
import Footer from "@/components/static/Footer.astro";
---

<!doctype html>
<html lang="en">
    <Head />
    <body class="mx-auto">
        <Header />
        {/* Content */}
        <main class="max-w-4xl mx-auto">
            <slot />
        </main>
        <Footer />
        <pagefind-modal-trigger shortcut="mod+k" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)"></pagefind-modal-trigger>
        <pagefind-modal reset-on-close></pagefind-modal>
    </body>
</html>
