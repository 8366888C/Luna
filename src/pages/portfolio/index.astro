---
import FilterPortfolio from "@/components/client/FilterPortfolio";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { RiArrowGoBackLine } from "@remixicon/react";
import portfolio_config from "@/portfolio-config.json";
import { parse } from "date-fns";
import type { portfolioConfig } from "@/lib/types";

const projects = portfolio_config.sort((a, b) => {
	const dateA = parse(a.date, "dd-MM-yyyy", new Date());
	const dateB = parse(b.date, "dd-MM-yyyy", new Date());
	return dateB.getTime() - dateA.getTime();
});
---

<BaseLayout>
	<div transition:animate="fade">
		<div class="border border-border p-6 mt-10">
			<a href="/" class="button group inline-block">
				<div class="flex items-center gap-2 active:translate-x-1 animation">
					<RiArrowGoBackLine className="size-4 fill-muted-foreground group-hover:fill-foreground" />
					<span class="text-muted-foreground group-hover:text-foreground">back</span>
				</div>
			</a>

			<h1 class="pt-3 pb-3 text-5xl font-semibold select-none">Portfolio</h1>
		</div>
		<div class="mt-3">
			<FilterPortfolio client:load items={projects as portfolioConfig[]} />
		</div>
	</div>
</BaseLayout>
