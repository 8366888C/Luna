---
import Section from "@/components/fragments/Section.astro";
import Introduction from "@/components/fragments/Introduction.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import site_config from "@/site-config.json";
---

<BaseLayout>
  <div>
    <section>
      {site_config.bIntroduction && <Introduction />}
    </section>

    <hr />

    {
      (site_config.featured.portfolio.visible ||
        site_config.featured.blog.visible) && (
        <section>
          <Section />
        </section>
      )
    }
  </div>
</BaseLayout>
